# --- Banco de dados ---
# Local com o docker-compose.yml da raiz: postgresql://myplanner:myplanner@localhost:5432/myplanner
# Em produção, aponte para o Postgres hospedado em nuvem.
DATABASE_URL="postgresql://myplanner:myplanner@localhost:5432/myplanner"

# --- Servidor ---
PORT=3333
NODE_ENV=development
# URL(s) do frontend autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGIN="http://localhost:5173"

# --- Autenticação (JWT) ---
# Gere valores fortes e aleatórios, ex: `openssl rand -hex 32`
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-access-token"
JWT_REFRESH_SECRET="troque-por-um-segredo-forte-de-refresh-token"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- E-mail (SMTP genérico) ---
# Funciona com qualquer provedor que fale SMTP: Resend, SendGrid, Mailgun,
# Amazon SES, ou um servidor SMTP próprio.
# Resend (SMTP): host smtp.resend.com, porta 587, user "resend", pass = sua API key
# SendGrid (SMTP): host smtp.sendgrid.net, porta 587, user "apikey", pass = sua API key
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="resend"
SMTP_PASSWORD=""
EMAIL_FROM="MyPlanner <notificacoes@seudominio.com>"
# Se true, e-mails só são logados no console em vez de enviados de verdade
# (útil em desenvolvimento local sem credenciais SMTP configuradas).
EMAIL_DRY_RUN=true

# --- Job de detecção de estagnação ---
# Expressão cron (node-cron). Padrão: todo dia às 08:00.
STALL_CHECK_CRON="0 8 * * *"
# Expressão cron do resumo semanal por e-mail. Padrão: toda segunda às 08:30.
WEEKLY_SUMMARY_CRON="30 8 * * 1"

# URL base do frontend, usada para montar links nos e-mails
APP_BASE_URL="http://localhost:5173"
